 coords 6363.199 350.314 5088.416
 userScript "	protected ref set<int> m_SpectatorPlayers = new set<int>();"\
 ""\
 "	override void OnGameStart()"\
 "	{"\
 "		super.OnGameStart();"\
 "		Print(\"Game started.\");"\
 "	}"\
 ""\
 "	override void OnPlayerKilled(int playerId, IEntity playerEntity, IEntity killerEntity, notnull Instigator killer)"\
 "	{"\
 "		super.OnPlayerKilled(playerId, playerEntity, killerEntity, killer);"\
 "		PrintFormat(\"Player %1 died. Spawning at spectator point...\", playerId);"\
 ""\
 "		m_SpectatorPlayers.Insert(playerId);"\
 "		SpawnAtSpectatorPoint(playerId);"\
 "	}"\
 ""\
 "	// Get the faction via the faction component"\
 "	Faction GetPlayerFaction(int playerId)"\
 "	{"\
 "		IEntity controlledEntity = GetGame().GetPlayerManager().GetPlayerControlledEntity(playerId);"\
 "		if (!controlledEntity)"\
 "			return null;"\
 ""\
 "		SCR_PlayerFactionAffiliationComponent factionComponent = SCR_PlayerFactionAffiliationComponent.Cast(controlledEntity.FindComponent(SCR_PlayerFactionAffiliationComponent));"\
 "		if (factionComponent)"\
 "			return factionComponent.GetAffiliatedFaction();"\
 ""\
 "		return null;"\
 "	}"\
 ""\
 "	void SpawnAtSpectatorPoint(int playerId)"\
 "	{"\
 "		// Get the player's faction"\
 "		Faction faction = SCR_FactionManager.SGetPlayerFaction(playerId);"\
 "		if (!faction)"\
 "		{"\
 "			PrintFormat(\"No faction found for player %1\", playerId);"\
 "			return;"\
 "		}"\
 "	"\
 "		// Get a random loadout for the faction"\
 "		SCR_BasePlayerLoadout loadout = GetGame().GetLoadoutManager().GetRandomFactionLoadout(faction);"\
 "		if (!loadout)"\
 "		{"\
 "			PrintFormat(\"No loadout found for player %1\", playerId);"\
 "			return;"\
 "		}"\
 "	"\
 "		// Find a spawn point named \"Spectator\""\
 "		SCR_SpawnPoint targetPoint;"\
 "		array<SCR_SpawnPoint> spawnPoints = SCR_SpawnPoint.GetSpawnPoints();"\
 "		foreach (SCR_SpawnPoint sp : spawnPoints)"\
 "		{"\
 "			if (sp.GetSpawnPointName() == \"Spectator\")"\
 "			{"\
 "				targetPoint = sp;"\
 "				break;"\
 "			}"\
 "		}"\
 "	"\
 "		if (!targetPoint)"\
 "		{"\
 "			Print(\"Spectator spawn point not found\", LogLevel.ERROR);"\
 "			return;"\
 "		}"\
 "	"\
 "		// Create spawn data"\
 "		SCR_SpawnPointSpawnData spawnData = new SCR_SpawnPointSpawnData(loadout.GetLoadoutResource(), targetPoint.GetRplId());"\
 "	"\
 "		// Get the player's RespawnComponent and request spawn"\
 "		SCR_RespawnComponent respawnComp = SCR_RespawnComponent.Cast(GetGame().GetPlayerManager().GetPlayerRespawnComponent(playerId));"\
 "		if (!respawnComp)"\
 "		{"\
 "			PrintFormat(\"No RespawnComponent found for player %1\", playerId);"\
 "			return;"\
 "		}"\
 "	"\
 "		respawnComp.RequestSpawn(spawnData);"\
 "	"\
 "		// Optional: Set camera to spectate after delay"\
 "		GetGame().GetCallqueue().CallLater(EnableSpectator, 5000, false, playerId);"\
 "	}"\
 ""\
 ""\
 "	void EnableSpectator(int playerId)"\
 "	{"\
 "		SCR_PlayerController pc = SCR_PlayerController.Cast(GetGame().GetPlayerManager().GetPlayerController(playerId));"\
 "		if (pc && !pc.IsSpectator())"\
 "		{"\
 "			pc.EnableSpectator();"\
 "			PrintFormat(\"Spectator mode enabled for player %1\", playerId);"\
 "		}"\
 "	}"\
 ""\
 "	override bool CanPlayerSpawn_S(SCR_SpawnRequestComponent requestComponent, SCR_SpawnHandlerComponent handlerComponent, SCR_SpawnData data, out SCR_ESpawnResult result = SCR_ESpawnResult.SPAWN_NOT_ALLOWED)"\
 "	{"\
 "		int playerId = requestComponent.GetPlayerId();"\
 ""\
 "		if (m_SpectatorPlayers.Contains(playerId))"\
 "		{"\
 "			result = SCR_ESpawnResult.CANNOT_SPAWN;"\
 "			return false;"\
 "		}"\
 ""\
 "		result = SCR_ESpawnResult.OK;"\
 "		return true;"\
 "	}"
}

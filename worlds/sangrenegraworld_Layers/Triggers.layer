SCR_BaseTriggerEntity check_generator {
 coords 5750.094 109.194 11245.059
 userScript "	protected IEntity m_generator;"
 TriggerActivationType "Every query"
 PeriodicQueries 1
 OnActivate ""\
 "		// Get world and generator reference"\
 "		BaseWorld world = GetGame().GetWorld();"\
 "		if (!world)"\
 "		{"\
 "			Print(\"[LOG] World not found\", LogLevel.ERROR);"\
 "			return;"\
 "		}"\
 ""\
 "		m_generator = world.FindEntityByName(\"objective_pump\");"\
 "		if (!m_generator)"\
 "		{"\
 "			Print(\"[LOG] Generator entity not found\", LogLevel.ERROR);"\
 "			return;"\
 "		}"\
 ""\
 "		EventHandlerManagerComponent eventComp = EventHandlerManagerComponent.Cast(m_generator.FindComponent(EventHandlerManagerComponent));"\
 "		if (!eventComp)"\
 "		{"\
 "			Print(\"[LOG] EventHandlerManagerComponent not found on generator\", LogLevel.ERROR);"\
 "			return;"\
 "		}"\
 ""\
 "		eventComp.RegisterScriptHandler(\"OnDestroyed\", m_generator, OnGeneratorDestroyed);"\
 "		Print(\"[LOG] Registered for generator destruction event\", LogLevel.NORMAL);"\
 "	}"\
 ""\
 "	void OnGeneratorDestroyed(IEntity destroyedEntity)"\
 "	{"\
 "		Print(\"[LOG] Generator destroyed! Triggering pipe explosions\", LogLevel.NORMAL);"\
 ""\
 "		for (int i = 1; i <= 22; i++)"\
 "		{"\
 "			string pipeName = \"pipe\" + i.ToString();"\
 "			GetGame().GetCallqueue().CallLater(TriggerPipeExplosion, i * 100, false, pipeName);"\
 "		}"\
 "	}"\
 ""\
 "	void TriggerPipeExplosion(string pipeName)"\
 "	{"\
 "		IEntity pipe = GetGame().GetWorld().FindEntityByName(pipeName);"\
 "		if (!pipe)"\
 "		{"\
 "			Print(\"[LOG] Could not find entity: \" + pipeName, LogLevel.WARNING);"\
 "			return;"\
 "		}"\
 ""\
 "		vector pos = pipe.GetOrigin();"\
 ""\
 "		// Particle"\
 "		ResourceName particleRes = \"{36E4FA5229FC8A9D}Particles/Logistics/Explosion/Fuel/Explosion_Fuel_Medium.ptc\";"\
 "		ParticleEffectEntitySpawnParams params = new ParticleEffectEntitySpawnParams();"\
 "		params.TransformMode = ETransformMode.WORLD;"\
 "		params.Transform[3] = pos;"\
 "		params.PlayOnSpawn = true;"\
 "		params.DeleteWhenStopped = true;"\
 "		ParticleEffectEntity.SpawnParticleEffect(particleRes, params);"\
 ""\
 "		// Sound"\
 "		string soundEmitterPrefab = \"{737DABC8DBED41EB}Prefabs/Props/Military/Radios/SoundEmitter.et\";"\
 "		IEntity soundEntity = GetGame().SpawnEntityPrefab(Resource.Load(soundEmitterPrefab), null, EntitySpawnParams());"\
 "		if (soundEntity)"\
 "		{"\
 "			soundEntity.SetOrigin(pos);"\
 "			SoundComponent soundComp = SoundComponent.Cast(soundEntity.FindComponent(SoundComponent));"\
 "			if (soundComp)"\
 "			{"\
 "				soundComp.SoundEvent(\"SOUND_EXPLOSION\");"\
 "			}"\
 "		}"\
 ""\
 "		// Explosive charge for pipe18 and pipe22"\
 "		if (pipeName == \"pipe18\" || pipeName == \"pipe22\")"\
 "		{"\
 "			SpawnAndTriggerExplosive(pos);"\
 "		}"\
 ""\
 "		SCR_EntityHelper.DeleteEntityAndChildren(pipe);"\
 "	}"\
 ""\
 "	void SpawnAndTriggerExplosive(vector position)"\
 "	{"\
 "		ResourceName particleRes = \"{69766E33781FC23F}Particles/Logistics/Explosion/Fuel/Explosion_Fuel_Large.ptc\";"\
 "		ParticleEffectEntitySpawnParams params = new ParticleEffectEntitySpawnParams();"\
 "		params.TransformMode = ETransformMode.WORLD;"\
 "		params.Transform[3] = position;"\
 "		params.PlayOnSpawn = true;"\
 "		params.DeleteWhenStopped = true;"\
 "		ParticleEffectEntity.SpawnParticleEffect(particleRes, params);"\
 "		ResourceName explosivePrefab = \"{7022AC2A675AABA5}Prefabs/Weapons/Explosives/DemoBlock_M112/DemoBlock_Big.et\";"\
 "	"\
 "		EntitySpawnParams spawnParams = EntitySpawnParams();"\
 "		spawnParams.TransformMode = ETransformMode.WORLD;"\
 "		spawnParams.Transform[3] = position;"\
 "	"\
 "		IEntity explosive = GetGame().SpawnEntityPrefab(Resource.Load(explosivePrefab), null, spawnParams);"\
 "		if (!explosive)"\
 "		{"\
 "			Print(\"[LOG] Failed to spawn explosive prefab\", LogLevel.ERROR);"\
 "			return;"\
 "		}"\
 "	"\
 "		// Add a small delay to ensure components are fully initialized"\
 "		GetGame().GetCallqueue().CallLater(DelayedExplosiveTrigger, 100, false, explosive);"\
 "		string soundEmitterPrefab = \"{737DABC8DBED41EB}Prefabs/Props/Military/Radios/SoundEmitter2.et\";"\
 "		IEntity soundEntity = GetGame().SpawnEntityPrefab(Resource.Load(soundEmitterPrefab), null, EntitySpawnParams());"\
 "		if (soundEntity)"\
 "		{"\
 "			soundEntity.SetOrigin(position);"\
 "			SoundComponent soundComp = SoundComponent.Cast(soundEntity.FindComponent(SoundComponent));"\
 "			if (soundComp)"\
 "			{"\
 "				soundComp.SoundEvent(\"SOUND_EXPLOSION\");"\
 "			}"\
 "		}"\
 "	}"\
 "	"\
 "	void DelayedExplosiveTrigger(IEntity explosive)"\
 "	{"\
 "		if (!explosive)"\
 "		{"\
 "			Print(\"[LOG] Explosive entity is null in delayed trigger\", LogLevel.ERROR);"\
 "			return;"\
 "		}"\
 "	"\
 "		SCR_ExplosiveTriggerComponent triggerComp = SCR_ExplosiveTriggerComponent.Cast(explosive.FindComponent(SCR_ExplosiveTriggerComponent));"\
 "		if (!triggerComp)"\
 "		{"\
 "			Print(\"[LOG] SCR_ExplosiveTriggerComponent not found on explosive\", LogLevel.ERROR);"\
 "			return;"\
 "		}"\
 "	"\
 "		triggerComp.UseTrigger();"\
 "		Print(\"[LOG] Explosive successfully triggered after delay\", LogLevel.NORMAL);"\
 "	"
}